# Local MySQL connection. Replace the placeholder credentials locally.
DATABASE_URL="mysql://staypilot_app:change-me@127.0.0.1:3306/staypilot_dev"

# Public application origin, read by server code to construct links.
APP_URL="http://localhost:3000"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Private S3-compatible storage for complaint attachments.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Gmail SMTP delivery for password resets and invitations.
# Create an app password for the Gmail account after enabling 2-Step Verification.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=""

# Authenticated Vercel Cron endpoint access.
CRON_SECRET=
