# Local MySQL connection. Replace the placeholder credentials locally.
DATABASE_URL="mysql://staypilot_app:change-me@127.0.0.1:3306/staypilot_dev"

# Public application origin, read by server code to construct links.
APP_URL="http://localhost:3000"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Private file storage (configured when the files module begins).
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Transactional email (configured when the email adapter is implemented).
RESEND_API_KEY=
EMAIL_FROM=

# Authenticated Vercel Cron endpoint access.
CRON_SECRET=
