model FoodMenu {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String         @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt         @map("organization_id") @db.UnsignedBigInt
  propertyId     BigInt         @map("pg_id") @db.UnsignedBigInt
  title          String?        @db.VarChar(160)
  validFrom      DateTime       @map("valid_from") @db.Date
  validTo        DateTime       @map("valid_to") @db.Date
  status         String         @default("DRAFT") @db.VarChar(20)
  createdById    BigInt         @map("created_by") @db.UnsignedBigInt
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  publishedAt    DateTime?      @map("published_at") @db.DateTime(3)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  property       Property       @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  createdBy      User           @relation("FoodMenuCreator", fields: [createdById], references: [id])
  items          FoodMenuItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status, validFrom, validTo])
  @@map("food_menus")
}

model FoodMenuItem {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt       @map("organization_id") @db.UnsignedBigInt
  propertyId     BigInt       @map("pg_id") @db.UnsignedBigInt
  menuId         BigInt       @map("food_menu_id") @db.UnsignedBigInt
  mealTypeId     BigInt       @map("meal_type_id") @db.UnsignedBigInt
  menuDate       DateTime     @map("menu_date") @db.Date
  dishName       String       @map("dish_name") @db.VarChar(255)
  description    String?      @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  menu           FoodMenu     @relation(fields: [organizationId, propertyId, menuId], references: [organizationId, propertyId, id], onDelete: Cascade)
  mealType       FoodMealType @relation(fields: [organizationId, propertyId, mealTypeId], references: [organizationId, propertyId, id])

  @@index([organizationId, propertyId, menuDate, mealTypeId])
  @@map("food_menu_items")
}

model FoodPoll {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String           @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt           @map("organization_id") @db.UnsignedBigInt
  propertyId     BigInt           @map("pg_id") @db.UnsignedBigInt
  mealTypeId     BigInt           @map("meal_type_id") @db.UnsignedBigInt
  mealDate       DateTime         @map("meal_date") @db.Date
  opensAt        DateTime         @map("opens_at") @db.DateTime(3)
  closesAt       DateTime         @map("closes_at") @db.DateTime(3)
  status         String           @default("OPEN") @db.VarChar(20)
  createdById    BigInt           @map("created_by") @db.UnsignedBigInt
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  property       Property         @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  mealType       FoodMealType     @relation(fields: [organizationId, propertyId, mealTypeId], references: [organizationId, propertyId, id])
  createdBy      User             @relation("FoodPollCreator", fields: [createdById], references: [id])
  options        FoodPollOption[]
  votes          FoodVote[]

  @@unique([organizationId, id])
  @@unique([propertyId, mealDate, mealTypeId])
  @@index([organizationId, propertyId, mealDate, status])
  @@map("food_polls")
}

model FoodPollOption {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId     String     @unique @default(uuid()) @map("public_id") @db.Char(36)
  pollId       BigInt     @map("food_poll_id") @db.UnsignedBigInt
  label        String     @db.VarChar(180)
  displayOrder Int        @default(0) @map("display_order")
  poll         FoodPoll   @relation(fields: [pollId], references: [id])
  votes        FoodVote[]

  @@unique([pollId, id])
  @@map("food_poll_options")
}

model FoodVote {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt         @map("organization_id") @db.UnsignedBigInt
  pollId         BigInt         @map("food_poll_id") @db.UnsignedBigInt
  residentStayId BigInt         @map("resident_stay_id") @db.UnsignedBigInt
  optionId       BigInt         @map("option_id") @db.UnsignedBigInt
  suggestion     String?        @db.VarChar(500)
  votedAt        DateTime       @default(now()) @map("voted_at") @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  poll           FoodPoll       @relation(fields: [organizationId, pollId], references: [organizationId, id])
  residentStay   ResidentStay   @relation(fields: [organizationId, residentStayId], references: [organizationId, id])
  option         FoodPollOption @relation(fields: [pollId, optionId], references: [pollId, id])

  @@unique([pollId, residentStayId])
  @@index([organizationId, residentStayId, votedAt])
  @@map("food_votes")
}

model ResidentFoodUnavailability {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String       @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt       @map("organization_id") @db.UnsignedBigInt
  propertyId     BigInt       @map("pg_id") @db.UnsignedBigInt
  residentStayId BigInt       @map("resident_stay_id") @db.UnsignedBigInt
  startsOn       DateTime     @map("starts_on") @db.Date
  endsOn         DateTime     @map("ends_on") @db.Date
  cancelledAt    DateTime?    @map("cancelled_at") @db.DateTime(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id])
  property       Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  residentStay   ResidentStay @relation(fields: [organizationId, residentStayId], references: [organizationId, id])

  @@index([organizationId, propertyId, startsOn, endsOn, cancelledAt], map: "resident_food_unavailability_property_range_idx")
  @@index([organizationId, residentStayId, startsOn, endsOn, cancelledAt], map: "resident_food_unavailability_stay_range_idx")
  @@map("resident_food_unavailability")
}

model Notice {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String       @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt       @map("organization_id") @db.UnsignedBigInt
  propertyId     BigInt?      @map("pg_id") @db.UnsignedBigInt
  title          String       @db.VarChar(160)
  body           String       @db.Text
  publishedAt    DateTime     @default(now()) @map("published_at") @db.DateTime(3)
  expiresOn      DateTime?    @map("expires_on") @db.Date
  archivedAt     DateTime?    @map("archived_at") @db.DateTime(3)
  createdById    BigInt       @map("created_by") @db.UnsignedBigInt
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id])
  property       Property?    @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  createdBy      User         @relation("NoticeCreator", fields: [createdById], references: [id])

  @@unique([organizationId, id])
  @@index([organizationId, propertyId, archivedAt, publishedAt])
  @@index([organizationId, expiresOn])
  @@map("notices")
}

model InvoiceItem {
  id                    BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  invoiceId             BigInt                 @map("invoice_id") @db.UnsignedBigInt
  itemType              String                 @map("item_type") @db.VarChar(40)
  description           String                 @db.VarChar(255)
  quantity              Decimal                @default(1) @db.Decimal(12, 3)
  unitAmountPaise       BigInt                 @map("unit_amount_paise")
  amountPaise           BigInt                 @map("amount_paise")
  createdAt             DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  invoice               Invoice                @relation(fields: [invoiceId], references: [id])
  electricityAllocation ElectricityAllocation?

  @@index([invoiceId])
  @@map("invoice_items")
}

model Reservation {
  id                   BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId             String                       @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId       BigInt                       @map("organization_id") @db.UnsignedBigInt
  propertyId           BigInt                       @map("pg_id") @db.UnsignedBigInt
  residentId           BigInt                       @map("resident_id") @db.UnsignedBigInt
  bedId                BigInt                       @map("bed_id") @db.UnsignedBigInt
  reservationDate      DateTime                     @map("reservation_date") @db.Date
  reservationStartDate DateTime                     @map("reservation_start_date") @db.Date
  reservationEndDate   DateTime                     @map("reservation_end_date") @db.Date
  expectedMoveInDate   DateTime?                    @map("expected_move_in_date") @db.Date
  status               String                       @default("ACTIVE") @db.VarChar(30)
  activeResidentSlot   Int?                         @map("active_resident_slot") @db.UnsignedInt
  notes                String?                      @db.Text
  createdById          BigInt                       @map("created_by") @db.UnsignedBigInt
  createdAt            DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  cancelledAt          DateTime?                    @map("cancelled_at") @db.DateTime(3)
  cancelledById        BigInt?                      @map("cancelled_by") @db.UnsignedBigInt
  cancellationReason   String?                      @map("cancellation_reason") @db.VarChar(500)
  expiredAt            DateTime?                    @map("expired_at") @db.DateTime(3)
  expiredById          BigInt?                      @map("expired_by") @db.UnsignedBigInt
  organization         Organization                 @relation(fields: [organizationId], references: [id])
  property             Property                     @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  resident             Resident                     @relation(fields: [organizationId, residentId], references: [organizationId, id])
  bed                  Bed                          @relation(fields: [organizationId, propertyId, bedId], references: [organizationId, propertyId, id])
  createdBy            User                         @relation("ReservationCreator", fields: [createdById], references: [id])
  cancelledBy          User?                        @relation("ReservationCanceller", fields: [cancelledById], references: [id])
  expiredBy            User?                        @relation("ReservationExpirer", fields: [expiredById], references: [id])
  residentStays        ResidentStay[]
  payments             Payment[]
  depositTransactions  SecurityDepositTransaction[]

  // Active reservations use slot 1. Cancelled, expired, and moved-in records
  // clear it so the resident may reserve another bed while preserving history.
  @@unique([organizationId, residentId, activeResidentSlot], map: "reservations_active_resident_key")
  @@index([organizationId, propertyId, status, reservationStartDate, reservationEndDate], map: "reservations_property_period_idx")
  @@index([organizationId, residentId, reservationDate], map: "reservations_resident_date_idx")
  @@map("reservations")
}

model AuditLog {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId          String       @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId    BigInt       @map("organization_id") @db.UnsignedBigInt
  propertyId        BigInt?      @map("pg_id") @db.UnsignedBigInt
  actorUserPublicId String?      @map("actor_user_public_id") @db.Char(36)
  actorName         String       @map("actor_name") @db.VarChar(180)
  actionCode        String       @map("action_code") @db.VarChar(80)
  entityType        String       @map("entity_type") @db.VarChar(60)
  entityPublicId    String?      @map("entity_public_id") @db.Char(36)
  summary           String       @db.VarChar(500)
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  organization      Organization @relation(fields: [organizationId], references: [id])
  property          Property?    @relation(fields: [organizationId, propertyId], references: [organizationId, id])

  @@index([organizationId, createdAt])
  @@index([organizationId, propertyId, createdAt])
  @@index([organizationId, entityType, entityPublicId])
  @@map("audit_logs")
}

model Notification {
  id               BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String       @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId   BigInt       @map("organization_id") @db.UnsignedBigInt
  userId           BigInt       @map("user_id") @db.UnsignedBigInt
  propertyId       BigInt?      @map("pg_id") @db.UnsignedBigInt
  dedupeKey        String       @map("dedupe_key") @db.VarChar(180)
  notificationType String       @map("notification_type") @db.VarChar(40)
  title            String       @db.VarChar(180)
  message          String       @db.VarChar(500)
  actionUrl        String       @map("action_url") @db.VarChar(500)
  readAt           DateTime?    @map("read_at") @db.DateTime(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  property         Property?    @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, userId, dedupeKey], map: "notifications_org_user_dedupe_key")
  @@index([organizationId, userId, readAt, createdAt], map: "notifications_inbox_idx")
  @@index([organizationId, propertyId, createdAt], map: "notifications_property_idx")
  @@map("notifications")
}
