generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                               BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                         String                       @unique @default(uuid()) @map("public_id") @db.Char(36)
  email                            String                       @unique @db.VarChar(254)
  name                             String                       @db.VarChar(180)
  status                           String                       @default("INVITED") @db.VarChar(20)
  createdAt                        DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                        DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  memberships                      OrganizationMembership[]
  reservationsCreated              Reservation[]                @relation("ReservationCreator")
  reservationsCancelled            Reservation[]                @relation("ReservationCanceller")
  reservationsExpired              Reservation[]                @relation("ReservationExpirer")
  securityDepositTransactions      SecurityDepositTransaction[]
  checkoutProcessesCreated         CheckoutProcess[]            @relation("CheckoutProcessCreator")
  electricityReadings              ElectricityMeterReading[]    @relation("ElectricityReadingRecorder")
  electricityBillsCreated          ElectricityBill[]            @relation("ElectricityBillCreator")
  foodPollsCreated                 FoodPoll[]                   @relation("FoodPollCreator")
  foodMenusCreated                 FoodMenu[]                   @relation("FoodMenuCreator")
  electricityAllocationsOverridden ElectricityAllocation[]      @relation("ElectricityAllocationOverrider")
  assignedComplaints               Complaint[]                  @relation("ComplaintAssignee")
  complaintEvents                  ComplaintEvent[]             @relation("ComplaintEventActor")
  complaintAttachments             ComplaintAttachment[]        @relation("ComplaintAttachmentUploader")
  noticesCreated                   Notice[]                     @relation("NoticeCreator")
  invitationsCreated               UserInvitation[]             @relation("UserInvitationCreator")
  notifications                    Notification[]
  residentDocumentsUploaded        ResidentDocument[]           @relation("ResidentDocumentUploader")
  residentDocumentsReviewed        ResidentDocument[]           @relation("ResidentDocumentReviewer")

  @@map("users")
}

model AuthIdentity {
  id            String        @id @db.VarChar(36)
  name          String        @db.VarChar(180)
  email         String        @unique @db.VarChar(254)
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("auth_identities")
}

model AuthSession {
  id        String       @id @db.VarChar(36)
  expiresAt DateTime     @map("expires_at") @db.DateTime(3)
  token     String       @unique @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  ipAddress String?      @map("ip_address") @db.VarChar(128)
  userAgent String?      @map("user_agent") @db.Text
  userId    String       @map("user_id") @db.VarChar(36)
  user      AuthIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String       @id @db.VarChar(36)
  accountId             String       @map("account_id") @db.VarChar(255)
  providerId            String       @map("provider_id") @db.VarChar(100)
  userId                String       @map("user_id") @db.VarChar(36)
  accessToken           String?      @map("access_token") @db.Text
  refreshToken          String?      @map("refresh_token") @db.Text
  idToken               String?      @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime?    @map("access_token_expires_at") @db.DateTime(3)
  refreshTokenExpiresAt DateTime?    @map("refresh_token_expires_at") @db.DateTime(3)
  scope                 String?      @db.Text
  password              String?      @db.Text
  createdAt             DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  user                  AuthIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @db.VarChar(36)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([identifier])
  @@map("auth_verifications")
}

model Organization {
  id                          BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                    String                       @unique @default(uuid()) @map("public_id") @db.Char(36)
  name                        String                       @db.VarChar(200)
  timezone                    String                       @default("Asia/Kolkata") @db.VarChar(64)
  status                      String                       @default("ACTIVE") @db.VarChar(20)
  demoExpiresAt               DateTime?                    @map("demo_expires_at") @db.DateTime(3)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  memberships                 OrganizationMembership[]
  properties                  Property[]
  floors                      Floor[]
  rooms                       Room[]
  beds                        Bed[]
  residents                   Resident[]
  residentStays               ResidentStay[]
  reservations                Reservation[]
  stayRentRates               StayRentRate[]
  invoices                    Invoice[]
  payments                    Payment[]
  securityDepositAccounts     SecurityDepositAccount[]
  securityDepositTransactions SecurityDepositTransaction[]
  checkoutProcesses           CheckoutProcess[]
  electricityMeters           ElectricityMeter[]
  electricityBills            ElectricityBill[]
  electricityReadings         ElectricityMeterReading[]
  electricityAllocations      ElectricityAllocation[]
  pgSettings                  PgSetting[]
  complaints                  Complaint[]
  userInvitations             UserInvitation[]
  mealTypes                   FoodMealType[]
  foodMenus                   FoodMenu[]
  foodPolls                   FoodPoll[]
  foodVotes                   FoodVote[]
  foodUnavailability          ResidentFoodUnavailability[]
  notices                     Notice[]
  auditLogs                   AuditLog[]
  notifications               Notification[]
  residentDocuments           ResidentDocument[]
  platformInvoices            PlatformInvoice[]

  @@map("organizations")
}

model PlatformBillingSettings {
  id             Int      @id @default(1)
  currency       String   @default("INR") @db.Char(3)
  monthlyRate    Decimal  @default(0) @map("monthly_rate") @db.Decimal(12, 2)
  updatedByEmail String   @map("updated_by_email") @db.VarChar(254)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("platform_billing_settings")
}

model PlatformOwnerInvitation {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String    @unique @default(uuid()) @map("public_id") @db.Char(36)
  email          String    @db.VarChar(254)
  ownerName      String    @map("owner_name") @db.VarChar(180)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  acceptedAt     DateTime? @map("accepted_at") @db.DateTime(3)
  createdByEmail String    @map("created_by_email") @db.VarChar(254)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  demoDurationHours Int?   @map("demo_duration_hours")
  demoRequest    DemoRequest?

  @@index([email, acceptedAt, expiresAt])
  @@map("platform_owner_invitations")
}

model DemoRequest {
  id                 BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String                 @unique @default(uuid()) @map("public_id") @db.Char(36)
  name               String                 @db.VarChar(180)
  email              String                 @db.VarChar(254)
  phoneCountryCode   String                 @map("phone_country_code") @db.VarChar(8)
  phoneNumber        String                 @map("phone_number") @db.VarChar(30)
  address            String                 @db.VarChar(500)
  status             String                 @default("PENDING") @db.VarChar(20)
  invitationId       BigInt?                @unique @map("invitation_id") @db.UnsignedBigInt
  reviewedByEmail    String?                @map("reviewed_by_email") @db.VarChar(254)
  reviewedAt         DateTime?              @map("reviewed_at") @db.DateTime(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  invitation         PlatformOwnerInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("demo_requests")
}

model PlatformInvoice {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String            @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt            @map("organization_id") @db.UnsignedBigInt
  propertyId     BigInt?           @map("property_id") @db.UnsignedBigInt
  period         String            @db.Char(7)
  activePgCount  Int               @map("active_pg_count")
  monthlyRate    Decimal           @map("monthly_rate") @db.Decimal(12, 2)
  currency       String            @db.Char(3)
  totalAmount    Decimal           @map("total_amount") @db.Decimal(14, 2)
  status         String            @default("OPEN") @db.VarChar(20)
  dueAt          DateTime          @map("due_at") @db.DateTime(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property?         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  payments       PlatformPayment[]

  @@unique([organizationId, propertyId, period])
  @@index([propertyId])
  @@index([organizationId, status, dueAt])
  @@index([period, status])
  @@map("platform_invoices")
}

model PlatformPayment {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String          @unique @default(uuid()) @map("public_id") @db.Char(36)
  invoiceId        BigInt          @map("invoice_id") @db.UnsignedBigInt
  amount           Decimal         @db.Decimal(14, 2)
  method           String          @db.VarChar(30)
  reference        String?         @db.VarChar(180)
  paidAt           DateTime        @map("paid_at") @db.DateTime(3)
  status           String          @default("PENDING") @db.VarChar(20)
  submittedByEmail String          @map("submitted_by_email") @db.VarChar(254)
  reviewedByEmail  String?         @map("reviewed_by_email") @db.VarChar(254)
  reviewedAt       DateTime?       @map("reviewed_at") @db.DateTime(3)
  note             String?         @db.VarChar(500)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  invoice          PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status, createdAt])
  @@map("platform_payments")
}

model OrganizationMembership {
  id             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String                @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt                @map("organization_id") @db.UnsignedBigInt
  userId         BigInt                @map("user_id") @db.UnsignedBigInt
  residentId     BigInt?               @map("resident_id") @db.UnsignedBigInt
  status         String                @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization          @relation(fields: [organizationId], references: [id])
  user           User                  @relation(fields: [userId], references: [id])
  resident       Resident?             @relation(fields: [organizationId, residentId], references: [organizationId, id])
  roles          MembershipRole[]
  pgAssignments  ManagerPgAssignment[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@unique([organizationId, residentId])
  @@map("organization_memberships")
}

model MembershipRole {
  id           BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  membershipId BigInt                 @map("membership_id") @db.UnsignedBigInt
  roleCode     String                 @map("role_code") @db.VarChar(30)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id])

  @@unique([membershipId, roleCode])
  @@map("membership_roles")
}

model ManagerPgAssignment {
  id             BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt                 @map("organization_id") @db.UnsignedBigInt
  membershipId   BigInt                 @map("membership_id") @db.UnsignedBigInt
  propertyId     BigInt                 @map("pg_id") @db.UnsignedBigInt
  status         String                 @default("ACTIVE") @db.VarChar(20)
  membership     OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id])
  property       Property               @relation(fields: [organizationId, propertyId], references: [organizationId, id])

  @@unique([membershipId, propertyId])
  @@map("manager_pg_assignments")
}

model UserInvitation {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String                   @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt                   @map("organization_id") @db.UnsignedBigInt
  email          String                   @db.VarChar(254)
  roleCode       String                   @map("role_code") @db.VarChar(30)
  tokenHash      String                   @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime                 @map("expires_at") @db.DateTime(3)
  acceptedAt     DateTime?                @map("accepted_at") @db.DateTime(3)
  createdById    BigInt?                  @map("created_by") @db.UnsignedBigInt
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  residentId     BigInt?                  @map("resident_id") @db.UnsignedBigInt
  organization   Organization             @relation(fields: [organizationId], references: [id])
  resident       Resident?                @relation(fields: [organizationId, residentId], references: [organizationId, id], onDelete: Cascade)
  createdBy      User?                    @relation("UserInvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  properties     UserInvitationProperty[]

  @@unique([organizationId, id])
  @@index([organizationId, residentId])
  @@index([organizationId, roleCode, acceptedAt, expiresAt], map: "user_invites_org_role_exp_idx")
  @@map("user_invitations")
}

model UserInvitationProperty {
  organizationId BigInt         @map("organization_id") @db.UnsignedBigInt
  invitationId   BigInt         @map("invitation_id") @db.UnsignedBigInt
  propertyId     BigInt         @map("pg_id") @db.UnsignedBigInt
  invitation     UserInvitation @relation(fields: [organizationId, invitationId], references: [organizationId, id], onDelete: Cascade)
  property       Property       @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, invitationId, propertyId])
  @@index([organizationId, propertyId])
  @@map("user_invitation_pgs")
}

model Property {
  id                      BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                String                       @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId          BigInt                       @map("organization_id") @db.UnsignedBigInt
  name                    String                       @db.VarChar(180)
  code                    String?                      @db.VarChar(50)
  addressLine1            String                       @map("address_line1") @db.VarChar(255)
  addressLine2            String?                      @map("address_line2") @db.VarChar(255)
  city                    String                       @db.VarChar(100)
  state                   String                       @db.VarChar(100)
  postalCode              String                       @map("postal_code") @db.VarChar(20)
  contactPhone            String?                      @map("contact_phone") @db.VarChar(30)
  contactEmail            String?                      @map("contact_email") @db.VarChar(254)
  status                  String                       @default("ACTIVE") @db.VarChar(20)
  createdAt               DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  organization            Organization                 @relation(fields: [organizationId], references: [id])
  floors                  Floor[]
  rooms                   Room[]
  beds                    Bed[]
  assignments             ManagerPgAssignment[]
  invitationAssignments   UserInvitationProperty[]
  residentStays           ResidentStay[]
  reservations            Reservation[]
  stayRentRates           StayRentRate[]
  invoices                Invoice[]
  payments                Payment[]
  securityDepositAccounts SecurityDepositAccount[]
  checkoutProcesses       CheckoutProcess[]
  electricityMeters       ElectricityMeter[]
  electricityBills        ElectricityBill[]
  settings                PgSetting?
  complaints              Complaint[]
  mealTypes               FoodMealType[]
  foodMenus               FoodMenu[]
  foodPolls               FoodPoll[]
  foodUnavailability      ResidentFoodUnavailability[]
  notices                 Notice[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  residentDocuments       ResidentDocument[]
  platformInvoices        PlatformInvoice[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("pgs")
}

model Floor {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  publicId          String             @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId    BigInt             @map("organization_id") @db.UnsignedBigInt
  propertyId        BigInt             @map("pg_id") @db.UnsignedBigInt
  name              String             @map("floor_name") @db.VarChar(100)
  number            Int?               @map("floor_number")
  status            String             @default("ACTIVE") @db.VarChar(20)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  property          Property           @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  organization      Organization       @relation(fields: [organizationId], references: [id])
  rooms             Room[]
  beds              Bed[]
  electricityMeters ElectricityMeter[]

  @@unique([organizationId, propertyId, id])
  @@unique([propertyId, name])
  @@index([organizationId, propertyId, status])
  @@map("floors")
}

model Room {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  publicId          String             @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId    BigInt             @map("organization_id") @db.UnsignedBigInt
  propertyId        BigInt             @map("pg_id") @db.UnsignedBigInt
  floorId           BigInt             @map("floor_id") @db.UnsignedBigInt
  number            String             @map("room_number") @db.VarChar(50)
  status            String             @default("ACTIVE") @db.VarChar(20)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  property          Property           @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  organization      Organization       @relation(fields: [organizationId], references: [id])
  floor             Floor              @relation(fields: [organizationId, propertyId, floorId], references: [organizationId, propertyId, id])
  beds              Bed[]
  electricityMeters ElectricityMeter[]

  @@unique([organizationId, propertyId, id])
  @@unique([propertyId, number])
  @@index([organizationId, propertyId, floorId])
  @@map("rooms")
}

model Bed {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String         @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt         @map("organization_id") @db.UnsignedBigInt
  propertyId     BigInt         @map("pg_id") @db.UnsignedBigInt
  floorId        BigInt         @map("floor_id") @db.UnsignedBigInt
  roomId         BigInt         @map("room_id") @db.UnsignedBigInt
  label          String         @map("bed_label") @db.VarChar(50)
  status         String         @default("ACTIVE") @map("operational_status") @db.VarChar(20)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  property       Property       @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  floor          Floor          @relation(fields: [organizationId, propertyId, floorId], references: [organizationId, propertyId, id])
  room           Room           @relation(fields: [organizationId, propertyId, roomId], references: [organizationId, propertyId, id])
  residentStays  ResidentStay[]
  reservations   Reservation[]

  @@unique([organizationId, propertyId, id], map: "beds_organization_id_pg_id_id_key")
  @@unique([propertyId, roomId, label])
  @@index([organizationId, propertyId, roomId, status])
  @@map("beds")
}

model Resident {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String                   @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt                   @map("organization_id") @db.UnsignedBigInt
  name           String                   @db.VarChar(180)
  phone          String                   @db.VarChar(30)
  email          String?                  @db.VarChar(254)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization             @relation(fields: [organizationId], references: [id])
  stays          ResidentStay[]
  reservations   Reservation[]
  payments       Payment[]
  invitations    UserInvitation[]
  memberships    OrganizationMembership[]
  documents      ResidentDocument[]

  @@unique([organizationId, id], map: "residents_organization_id_id_key")
  @@index([organizationId, name], map: "residents_organization_id_name_idx")
  @@index([organizationId, phone], map: "residents_organization_id_phone_idx")
  @@map("residents")
}

model ResidentDocument {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String       @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId BigInt       @map("organization_id") @db.UnsignedBigInt
  residentId     BigInt       @map("resident_id") @db.UnsignedBigInt
  propertyId     BigInt       @map("pg_id") @db.UnsignedBigInt
  uploadedById   BigInt       @map("uploaded_by") @db.UnsignedBigInt
  reviewedById   BigInt?      @map("reviewed_by") @db.UnsignedBigInt
  documentType   String       @map("document_type") @db.VarChar(40)
  status         String       @default("PENDING") @db.VarChar(20)
  objectKey      String       @unique @map("object_key") @db.VarChar(512)
  originalName   String       @map("original_name") @db.VarChar(255)
  contentType    String       @map("content_type") @db.VarChar(100)
  byteSize       Int          @map("byte_size") @db.UnsignedInt
  reviewNote     String?      @map("review_note") @db.VarChar(500)
  reviewedAt     DateTime?    @map("reviewed_at") @db.DateTime(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resident       Resident     @relation(fields: [organizationId, residentId], references: [organizationId, id], onDelete: Cascade)
  property       Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Cascade)
  uploadedBy     User         @relation("ResidentDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy     User?        @relation("ResidentDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, propertyId, residentId, status, createdAt], map: "resident_documents_resident_status_idx")
  @@index([organizationId, documentType, status], map: "resident_documents_type_status_idx")
  @@map("resident_documents")
}

model ResidentStay {
  id                     BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId               String                       @unique @default(uuid()) @map("public_id") @db.Char(36)
  organizationId         BigInt                       @map("organization_id") @db.UnsignedBigInt
  propertyId             BigInt                       @map("pg_id") @db.UnsignedBigInt
  residentId             BigInt                       @map("resident_id") @db.UnsignedBigInt
  bedId                  BigInt                       @map("bed_id") @db.UnsignedBigInt
  reservationId          BigInt?                      @map("reservation_id") @db.UnsignedBigInt
  startDate              DateTime                     @map("start_date") @db.Date
  endDate                DateTime?                    @map("end_date") @db.Date
  lockInMonths           Int                          @default(0) @map("lock_in_months") @db.UnsignedInt
  lockInEndDate          DateTime?                    @map("lock_in_end_date") @db.Date
  status                 String                       @default("ACTIVE") @db.VarChar(20)
  activeBedSlot          Int?                         @map("active_bed_slot") @db.UnsignedInt
  activeResidentSlot     Int?                         @map("active_resident_slot") @db.UnsignedInt
  createdAt              DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  organization           Organization                 @relation(fields: [organizationId], references: [id])
  property               Property                     @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  resident               Resident                     @relation(fields: [organizationId, residentId], references: [organizationId, id])
